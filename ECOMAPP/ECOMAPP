      </a>
    </div>
  </nav>

  <!-- HERO SECTION -->
  <section class="pt-32 pb-20 bg-gradient-to-b from-slate-900 via-brandDark to-slate-900 text-white relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      
      <div>
        <div class="inline-flex items-center space-x-2 bg-blue-500/20 text-blue-300 text-xs font-semibold px-3 py-1.5 rounded-full border border-blue-500/30 mb-6">
          <i data-lucide="shield-alert" class="w-4 h-4"></i>
          <span>Next-Generation Emergency Response Platform</span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black tracking-tight leading-tight mb-6">
          Resilient Crisis Support for <span class="text-blue-500">Citizens</span> & <span class="text-blue-400">Responders</span>
        </h1>
        <p class="text-slate-300 text-lg mb-8 leading-relaxed">
          Empowering citizens with real-time safety guidance and offline peer-to-peer communication, while providing First Responders with live operational mapping and START protocol triage.
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="#citizens" class="bg-brandBlue hover:bg-blue-600 text-white font-bold px-6 py-3.5 rounded-xl text-center shadow-lg transition flex items-center justify-center space-x-2">
            <i data-lucide="smartphone"></i>
            <span>ECOMAPP (Citizens)</span>
          </a>
          <a href="#responders" class="bg-slate-800 hover:bg-slate-700 text-white font-bold px-6 py-3.5 rounded-xl text-center border border-slate-700 transition flex items-center justify-center space-x-2">
