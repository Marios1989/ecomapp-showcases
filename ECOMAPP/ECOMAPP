            <span>ECOMAPP-FR (Responders)</span>
          </a>
        </div>
      </div>

      <!-- MOCKUP CONTAINER -->
      <div class="flex justify-center relative">
        <div class="w-72 h-[550px] bg-slate-800 rounded-[40px] p-4 border-4 border-slate-700 shadow-2xl relative">
          <div class="w-32 h-5 bg-slate-900 rounded-full mx-auto mb-4"></div>
