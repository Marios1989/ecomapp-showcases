        </div>
        <div class="p-4 bg-slate-800/50 rounded-xl border border-slate-700">
          <i data-lucide="database" class="w-8 h-8 text-blue-400 mx-auto mb-2"></i>
          <span class="text-xs font-semibold block">Interoperable Data</span>
        </div>
        <div class="p-4 bg-slate-800/50 rounded-xl border border-slate-700">
          <i data-lucide="smartphone" class="w-8 h-8 text-blue-400 mx-auto mb-2"></i>
          <span class="text-xs font-semibold block">Android & iOS Support</span>
        </div>
      </div>
    </div>
  </section>

