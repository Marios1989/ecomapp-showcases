            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ABOUT & EU HORIZON ACKNOWLEDGMENT -->
  <section id="about" class="py-12 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="max-w-3xl">
        <h2 class="text-2xl font-extrabold text-slate-900 mb-2">Developed within the SPARROW Project</h2>
        <p class="text-slate-600 text-sm leading-relaxed">
          Developed by <strong>Catalink</strong> under the EU <strong>Horizon Europe</strong> research program (Grant Agreement 101168499). SPARROW strengthens societal resilience and crisis management in the face of digital breakdowns.
        </p>
      </div>
      <div class="flex items-center space-x-3 bg-blue-50 border border-blue-200 p-4 rounded-xl">
        <div class="w-12 h-8 bg-blue-700 text-yellow-300 text-xs font-bold flex items-center justify-center rounded">★ EU ★</div>
        <div class="text-xs text-slate-700 font-semibold">
          Funded by the<br>European Union
        </div>
      </div>
    </div>
  </section>

  <!-- APP 1: ECOMAPP (CITIZENS) -->
  <section id="citizens" class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-brandBlue font-bold text-sm tracking-wider uppercase">For General Public</span>
        <h2 class="text-3xl font-black text-slate-900 mt-2 mb-4">ECOMAPP (Citizen Application)</h2>
        <p class="text-slate-600">
          Designed to enhance citizens' preparedness and response during emergencies through self-assessment, structured incident reporting, and off-grid communication.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        
        <!-- Feature 1 -->
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
          <div class="w-12 h-12 bg-blue-100 text-brandBlue rounded-xl flex items-center justify-center mb-4">
            <i data-lucide="clipboard-check"></i>
          </div>
          <h3 class="font-bold text-lg mb-2">Self-Assessment</h3>
          <p class="text-sm text-slate-600 leading-relaxed">
            Short guided questionnaire evaluating location, health status, and surroundings to provide tailored safety steps.
          </p>
        </div>

        <!-- Feature 2 -->
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
          <div class="w-12 h-12 bg-red-100 text-brandRed rounded-xl flex items-center justify-center mb-4">
            <i data-lucide="alert-triangle"></i>
          </div>
          <h3 class="font-bold text-lg mb-2">M/ETHANE Reporting</h3>
          <p class="text-sm text-slate-600 leading-relaxed">
            Send structured incident reports with hazard details, photos, and exact GPS coordinates directly to first responders.
          </p>
        </div>

        <!-- Feature 3 -->
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
          <div class="w-12 h-12 bg-green-100 text-green-600 rounded-xl flex items-center justify-center mb-4">
            <i data-lucide="wifi-off"></i>
          </div>
          <h3 class="font-bold text-lg mb-2">Nearby Chat (Mesh)</h3>
          <p class="text-sm text-slate-600 leading-relaxed">
            Peer-to-peer Bluetooth/Wi-Fi mesh networking allowing direct messages even when cellular or internet networks fail.
          </p>
        </div>

        <!-- Feature 4 -->
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
          <div class="w-12 h-12 bg-amber-100 text-amber-600 rounded-xl flex items-center justify-center mb-4">
            <i data-lucide="heart-pulse"></i>
          </div>
          <h3 class="font-bold text-lg mb-2">First Aid Guides</h3>
          <p class="text-sm text-slate-600 leading-relaxed">
            Categorized step-by-step guidance (Critical, Urgent, Minor) for CPR, severe bleeding, choking, and burns.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- APP 2: ECOMAPP-FR (FIRST RESPONDERS) -->
  <section id="responders" class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-brandBlue font-bold text-sm tracking-wider uppercase">Field Operations</span>
        <h2 class="text-3xl font-black text-slate-900 mt-2 mb-4">ECOMAPP-FR (First Responders)</h2>
        <p class="text-slate-600">
          Operational counterpart designed for rescue teams, providing real-time situational picture, on-scene triage, and route navigation.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <!-- Feature 1 -->
        <div class="bg-slate-50 p-8 rounded-2xl border border-slate-200">
          <div class="w-12 h-12 bg-blue-600 text-white rounded-xl flex items-center justify-center mb-4">
            <i data-lucide="map-pin"></i>
          </div>
          <h3 class="font-bold text-xl mb-3">Live Incident Map</h3>
          <p class="text-sm text-slate-600 leading-relaxed mb-4">
            Real-time display of citizen reports as color-coded pins. Filters by time/status with built-in navigation to the location.
          </p>
        </div>

        <!-- Feature 2 -->
        <div class="bg-slate-50 p-8 rounded-2xl border border-slate-200">
          <div class="w-12 h-12 bg-blue-600 text-white rounded-xl flex items-center justify-center mb-4">
            <i data-lucide="qr-code"></i>
          </div>
          <h3 class="font-bold text-xl mb-3">START Protocol Triage</h3>
          <p class="text-sm text-slate-600 leading-relaxed mb-4">
            Co-designed with Johanniter Austria (JOAFG). Rapid casualty categorization (Green, Yellow, Red, Black) via QR wristband scanning.
          </p>
        </div>

        <!-- Feature 3 -->
        <div class="bg-slate-50 p-8 rounded-2xl border border-slate-200">
          <div class="w-12 h-12 bg-blue-600 text-white rounded-xl flex items-center justify-center mb-4">
            <i data-lucide="navigation"></i>
          </div>
          <h3 class="font-bold text-xl mb-3">Traffic Re-routing</h3>
          <p class="text-sm text-slate-600 leading-relaxed mb-4">
            Integrated with RoadTwin systems to display real-time alternative routes and road closures during crisis transport.
          </p>
        </div>

      </div>
    </div>
  </section>

